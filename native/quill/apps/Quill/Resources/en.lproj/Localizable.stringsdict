<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>picker.start.words %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@words@</string>
		<key>words</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld word.</string>
			<key>other</key>
			<string>%lld words.</string>
		</dict>
	</dict>
	<key>picker.start.wordsCost %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@words@ · about %2$@.</string>
		<key>words</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld word</string>
			<key>other</key>
			<string>%lld words</string>
		</dict>
	</dict>
	<key>profiles.guidance.truncated %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Small models receive only the first %#@words@.</string>
		<key>words</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>word</string>
			<key>other</key>
			<string>%lld words</string>
		</dict>
	</dict>
	<key>providers.test.ok %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Connected · %#@models@</string>
		<key>models</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld model</string>
			<key>other</key>
			<string>%lld models</string>
		</dict>
	</dict>
</dict>
</plist>
