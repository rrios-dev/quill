<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Quill runs with the Hardened Runtime and WITHOUT the App Sandbox
	  (README D-02): reading the selection in other apps and pasting the result
	  needs the Accessibility permission, which the sandbox forbids.

	  No Hardened Runtime exceptions either (ARCHITECTURE §6): no microphone, no
	  JIT, no library-validation exception. Each one relaxes a real protection,
	  so adding one needs a reason recorded here.

	  audio-input (2026-10-07): meeting transcription (MEETINGS.md) transcribes
	  the user's own side from the microphone. The Hardened Runtime blocks the
	  microphone without it. Nothing is recorded: blocks go to the on-device
	  model and are dropped. Capturing the meeting app's output needs no
	  entitlement, only the System Audio Recording permission.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
